<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Assets/app.ico is generated by web/scripts/gen-icons.mjs (same glyph as the PWA). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>League Remote</Product>
    <AssemblyTitle>League Remote</AssemblyTitle>
    <!-- The built PWA (web/dist) is embedded and served to phones by the connector itself. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <WebDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'web'))</WebDir>
    <!-- -p:SkipWebBuild=true: never run npm; embed whatever web/dist contains (possibly nothing). -->
    <SkipWebBuild Condition="'$(SkipWebBuild)' == ''">false</SkipWebBuild>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="LeagueRemote.Connector.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web Push (RFC 8030/8291/8292, VAPID). On net6+ it uses BCL crypto only. -->
    <PackageReference Include="Lib.Net.Http.WebPush" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeagueRemote.Contracts\LeagueRemote.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LeagueRemote.Connector.Tests" />
  </ItemGroup>

  <!-- ===== Embedded PWA ===== -->

  <ItemGroup>
    <_WebBuildInput Include="$(WebDir)src\**\*;$(WebDir)public\**\*" />
    <_WebBuildInput Include="$(WebDir)index.html;$(WebDir)package.json;$(WebDir)package-lock.json;$(WebDir)vite.config.ts;$(WebDir)tsconfig*.json" />
  </ItemGroup>

  <!--
    Builds web/ when web/dist/index.html is missing or older than any web source (MSBuild Inputs/Outputs skip it otherwise).
    `npm ci` runs when web/node_modules is missing or web/package-lock.json is newer than the installed tree
    (web/node_modules/.package-lock.json, which npm rewrites on every install).
  -->
  <Target Name="BuildWeb"
          Condition="'$(SkipWebBuild)' != 'true'"
          Inputs="@(_WebBuildInput)"
          Outputs="$(WebDir)dist\index.html">
    <Exec Command="npm --version" StandardOutputImportance="low" IgnoreExitCode="true" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="_NpmExitCode" />
    </Exec>
    <Error Condition="'$(_NpmExitCode)' != '0'"
           Text="Building the embedded PWA needs Node.js (npm) on PATH. Install Node 22+, or pass -p:SkipWebBuild=true to embed an existing web/dist as is." />
    <Message Importance="high" Text="League Remote: building the PWA (web/) for embedding…" />
    <PropertyGroup>
      <_WebLockFile>$(WebDir)package-lock.json</_WebLockFile>
      <_WebInstalledLockFile>$(WebDir)node_modules\.package-lock.json</_WebInstalledLockFile>
      <_WebNeedsNpmCi>false</_WebNeedsNpmCi>
      <_WebNeedsNpmCi Condition="!Exists('$(_WebInstalledLockFile)')">true</_WebNeedsNpmCi>
      <_WebNeedsNpmCi Condition="'$(_WebNeedsNpmCi)' != 'true' and Exists('$(_WebLockFile)') and $([System.IO.File]::GetLastWriteTime('$(_WebLockFile)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(_WebInstalledLockFile)').Ticks)">true</_WebNeedsNpmCi>
    </PropertyGroup>
    <Message Condition="'$(_WebNeedsNpmCi)' == 'true'" Importance="high" Text="League Remote: web/node_modules is missing or older than package-lock.json, running npm ci…" />
    <Exec Condition="'$(_WebNeedsNpmCi)' == 'true'" Command="npm ci" WorkingDirectory="$(WebDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
  </Target>

  <!-- Embeds web/dist/** as pwa/** (served via ManifestEmbeddedFileProvider). Items are added at build time, after BuildWeb. -->
  <Target Name="EmbedPwa" BeforeTargets="BeforeBuild" DependsOnTargets="BuildWeb">
    <ItemGroup>
      <_PwaFile Include="$(WebDir)dist\**\*" />
      <EmbeddedResource Include="@(_PwaFile)"
                        Link="pwa\%(_PwaFile.RecursiveDir)%(_PwaFile.Filename)%(_PwaFile.Extension)"
                        WithCulture="false"
                        Type="Non-Resx" />
    </ItemGroup>
    <Warning Condition="!Exists('$(WebDir)dist\index.html')"
             Text="web/dist/index.html not found: the connector is built without the embedded PWA (it will only serve /setup)." />
  </Target>

  <!-- The ASP.NET Core shared framework brings the IIS in-process module along; the connector never runs under IIS. -->
  <Target Name="DropIisModuleFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'aspnetcorev2_inprocess.dll'" />
    </ItemGroup>
  </Target>

</Project>
